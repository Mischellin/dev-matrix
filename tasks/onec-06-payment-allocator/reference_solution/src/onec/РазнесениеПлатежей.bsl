// Модуль 1С:Предприятие 8.3 — РазнесениеПлатежей (Эталонное решение)
// Назначение: Автоматическое разнесение входящей оплаты по неоплаченным заказам клиента (FIFO)

Функция РазнестиОплатуПоЗаказам(ПараметрыПлатежа, ТаблицаЗаказов) Экспорт
    Если ПараметрыПлатежа.СуммаПлатежа < 0 Тогда
        ВызватьИсключение "Отрицательная сумма платежа недопустима";
    КонецЕсли;

    Результат = Новый Структура;
    ТаблицаРаспределения = Новый ТаблицаЗначений;
    ТаблицаРаспределения.Колонки.Добавить("НомерЗаказа");
    ТаблицаРаспределения.Колонки.Добавить("СуммаОплаты");
    ТаблицаРаспределения.Колонки.Добавить("СуммаНДС");
    ТаблицаРаспределения.Колонки.Добавить("ДолгПослеОплаты");

    ОстатокПлатежа = ПараметрыПлатежа.СуммаПлатежа;
    ВсегоРаспределено = 0.0;
    ВсегоНДС = 0.0;

    Если ОстатокПлатежа = 0 Или ТаблицаЗаказов.Количество() = 0 Тогда
        Результат.Вставить("ТаблицаРаспределения", ТаблицаРаспределения);
        Результат.Вставить("ОстатокАванса", ОстатокПлатежа);
        Результат.Вставить("ВсегоРаспределено", ВсегоРаспределено);
        Результат.Вставить("ВсегоНДС", ВсегоНДС);
        Возврат Результат;
    КонецЕсли;

    // Сортировка по FIFO: сначала ДатаЗаказа (по возрастанию), затем НомерЗаказа (по возрастанию)
    ТаблицаЗаказов.Сортировать("ДатаЗаказа Возр, НомерЗаказа Возр");

    Для Каждого Стр Из ТаблицаЗаказов Цикл
        Если ОстатокПлатежа <= 0 Тогда
            Прервать;
        КонецЕсли;

        ОстатокДолга = Стр.СуммаЗаказа - Стр.ОплаченоРанее;
        Если ОстатокДолга > 0 Тогда
            СуммаОплаты = Окр(Мин(ОстатокПлатежа, ОстатокДолга), 2);
            ДолгПосле = Окр(ОстатокДолга - СуммаОплаты, 2);

            // Расчет НДС в зависимости от ставки заказа
            СуммаНДС = 0.0;
            Если Стр.СтавкаНДС = "20%" Тогда
                СуммаНДС = Окр(СуммаОплаты * 20 / 120, 2);
            ИначеЕсли Стр.СтавкаНДС = "10%" Тогда
                СуммаНДС = Окр(СуммаОплаты * 10 / 110, 2);
            КонецЕсли;

            НоваяСтр = ТаблицаРаспределения.Добавить();
            НоваяСтр.НомерЗаказа = Стр.НомерЗаказа;
            НоваяСтр.СуммаОплаты = СуммаОплаты;
            НоваяСтр.СуммаНДС = СуммаНДС;
            НоваяСтр.ДолгПослеОплаты = ДолгПосле;

            ОстатокПлатежа = Окр(ОстатокПлатежа - СуммаОплаты, 2);
            ВсегоРаспределено = ВсегоРаспределено + СуммаОплаты;
            ВсегоНДС = ВсегоНДС + СуммаНДС;
        КонецЕсли;
    КонецЦикла;

    Результат.Вставить("ТаблицаРаспределения", ТаблицаРаспределения);
    Результат.Вставить("ОстатокАванса", Окр(ОстатокПлатежа, 2));
    Результат.Вставить("ВсегоРаспределено", Окр(ВсегоРаспределено, 2));
    Результат.Вставить("ВсегоНДС", Окр(ВсегоНДС, 2));

    Возврат Результат;
КонецФункции
