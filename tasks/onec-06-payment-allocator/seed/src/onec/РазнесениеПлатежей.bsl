// Модуль 1С:Предприятие 8.3 — РазнесениеПлатежей (Заготовка)
// ВНИМАНИЕ: Заготовка не проверяет отрицательные суммы, не сортирует по FIFO,
// не вычисляет НДС и не учитывает остаток аванса.

Функция РазнестиОплатуПоЗаказам(ПараметрыПлатежа, ТаблицаЗаказов) Экспорт
    Результат = Новый Структура;
    ТаблицаРаспределения = Новый ТаблицаЗначений;
    ТаблицаРаспределения.Колонки.Добавить("НомерЗаказа");
    ТаблицаРаспределения.Колонки.Добавить("СуммаОплаты");
    ТаблицаРаспределения.Колонки.Добавить("СуммаНДС");
    ТаблицаРаспределения.Колонки.Добавить("ДолгПослеОплаты");

    ОстатокПлатежа = ПараметрыПлатежа.СуммаПлатежа;
    ВсегоРаспределено = 0.0;
    ВсегоНДС = 0.0;

    Для Каждого Стр Из ТаблицаЗаказов Цикл
        Если ОстатокПлатежа <= 0 Тогда
            Прервать;
        КонецЕсли;

        ОстатокДолга = Стр.СуммаЗаказа - Стр.ОплаченоРанее;
        Если ОстатокДолга > 0 Тогда
            СуммаОплаты = Мин(ОстатокПлатежа, ОстатокДолга);
            ДолгПосле = ОстатокДолга - СуммаОплаты;

            НоваяСтр = ТаблицаРаспределения.Добавить();
            НоваяСтр.НомерЗаказа = Стр.НомерЗаказа;
            НоваяСтр.СуммаОплаты = СуммаОплаты;
            НоваяСтр.СуммаНДС = 0.0;
            НоваяСтр.ДолгПослеОплаты = ДолгПосле;

            ОстатокПлатежа = ОстатокПлатежа - СуммаОплаты;
            ВсегоРаспределено = ВсегоРаспределено + СуммаОплаты;
        КонецЕсли;
    КонецЦикла;

    Результат.Вставить("ТаблицаРаспределения", ТаблицаРаспределения);
    Результат.Вставить("ОстатокАванса", 0.0);
    Результат.Вставить("ВсегоРаспределено", ВсегоРаспределено);
    Результат.Вставить("ВсегоНДС", 0.0);

    Возврат Результат;
КонецФункции
